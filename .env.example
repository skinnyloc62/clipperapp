# Copy to .env (never commit real secrets). Section 1 needs nothing filled to run the skeleton.
# Database (Supabase Postgres) — required from Section 2 onward, not for Section 1 skeleton.
# Pooled (port 6543) for the app; direct (5432) for migrations. From Supabase
# dashboard: Project Settings -> Database, or via Vercel Marketplace Supabase.
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"
# Blob storage token (Vercel Blob) — required from Section 2 onward.
BLOB_READ_WRITE_TOKEN=""
# Shared gate password for the dashboard (Section 2 auth).
APP_PASSWORD="change-me"
# Session seal secret (>= 32 chars). Required for login cookies.
SESSION_SECRET="dev-only-session-secret-at-least-32-chars"
# Remote MCP access: bearer token for POST /api/mcp + owner email it maps to.
# Generate with: openssl rand -hex 32. Never commit the real value.
MCP_API_TOKEN=""
MCP_USER_EMAIL="husband@streetethics.local"
# Storage driver: local (dev, ./.data/) or blob (Vercel). Section 1 defaults to local stub.
STORAGE_DRIVER="local"
# Optional overrides for system ffmpeg/ffprobe paths.
FFMPEG_PATH=""
FFPROBE_PATH=""
# Upload / clip limits.
MAX_UPLOAD_MB="500"
MAX_CLIP_SEC="60"
