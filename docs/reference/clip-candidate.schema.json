{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "HGE Clip Candidate",
  "required": [
    "source_id",
    "start_seconds",
    "end_seconds",
    "hook",
    "score",
    "score_breakdown",
    "rights_status",
    "campaign_eligibility",
    "recommended_action"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_seconds": {
      "type": "number",
      "minimum": 0
    },
    "end_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "transcript_excerpt": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "why_it_works": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "score_breakdown": {
      "type": "object",
      "required": [
        "hook",
        "clarity",
        "payoff",
        "novelty",
        "emotion",
        "fit",
        "technical"
      ],
      "properties": {
        "hook": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "clarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "payoff": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "novelty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "emotion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "fit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "technical": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "rights_status": {
      "enum": [
        "verified",
        "needs_review",
        "blocked"
      ]
    },
    "campaign_eligibility": {
      "enum": [
        "eligible",
        "unknown",
        "ineligible"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "enum": [
        "reject",
        "queue_human_review",
        "request_missing_evidence",
        "prepare_edit_plan"
      ]
    }
  }
}
